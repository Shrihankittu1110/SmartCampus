PORT=5000
NODE_ENV=development
MONGODB_URI=Enter you MongoDB connection string here (e.g., mongodb://localhost:27017/campusflow)
CLIENT_URL=http://localhost:5173

JWT_ACCESS_SECRET=campusflow_super_secret_access_key_2026_jwt
JWT_REFRESH_SECRET=campusflow_super_secret_refresh_key_2026_jwt
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email Configuration (for password reset / verification notifications)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=CampusFlow <noreply@campusflow.edu>

# AI API Key (Optional: Google Gemini / OpenAI key; if omitted, intelligent deterministic fallback is active)
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Uploads directory relative or absolute
UPLOAD_DIR=uploads
